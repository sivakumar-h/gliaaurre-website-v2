# Email delivery via Resend (src/lib/email.ts)
RESEND_API_KEY=

# Sender address. Use onboarding@resend.dev while testing;
# switch to noreply@gliaaurre.com after the domain is verified in Resend.
FROM_EMAIL=onboarding@resend.dev

# Who receives CAREERS page job applications.
# Multiple addresses allowed, separated by commas.
OWNER_EMAIL=

# Who receives CONTACT page submissions.
# Multiple addresses allowed, separated by commas.
CONTACT_RECEIVER_EMAIL=
